# ZYNZYA environment — ALL optional for local build/dev.
# The app builds and runs with none of these set; order persistence and payments
# simply degrade gracefully (orders computed in-memory, payments return 503).

# Supabase (order persistence). Without these, POST /api/orders still returns the
# computed order with persisted:false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional). Without this, POST /api/checkout/payment-intent returns 503.
STRIPE_SECRET_KEY=

# Set to "true" to enable verbose [prefix] logging outside development.
TESTING_MODE=

# ── Admin auth (internal /admin area only — NOT customer checkout) ────────────
# Gates the admin dashboard + admin order APIs with a signed JWT (jose, HS256)
# in an httpOnly `zy_admin` cookie (8h). If ADMIN_JWT_SECRET is unset, admin
# login fails closed (401) with a logged error — the build/storefront are
# unaffected and guest checkout stays unauthenticated.

# HS256 signing secret for the admin session JWT. Use a long random string,
# e.g.  openssl rand -base64 48
ADMIN_JWT_SECRET=

# Admin username.
ADMIN_USERNAME=

# Admin password — set EXACTLY ONE of the following:
#   ADMIN_PASSWORD_HASH  (recommended): lowercase hex SHA-256 of the password.
#     Generate with:
#       node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode(process.argv[1])).then(b=>console.log(Buffer.from(b).toString('hex')))" 'your-password'
#   ADMIN_PASSWORD       (simplest): plaintext password.
# If both are set, ADMIN_PASSWORD_HASH wins.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
